    { "id": "hover-tilt", "type": "gyro-angle", "x": 3.5, "y": 5.5, "props": { "a": "hover-deck", "ax": 0, "ay": 0, "hold": 12 } },

    { "id": "hex-cup", "type": "polygon", "x": 13.1, "y": 0.6, "props": { "sides": 6, "size": 0.7, "hollow": true, "wall": 0.1, "color": "#f59e0b" } },
